{
  "name": "dr-siddharth-gupta-ortho",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website for Dr. Siddharth Gupta — orthopaedic & robotic joint replacement surgeon, Kolkata & Howrah",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-dist.mjs && node scripts/check-contrast.mjs",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
