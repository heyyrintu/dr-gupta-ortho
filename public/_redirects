# Netlify / Cloudflare Pages. First match wins.
# Pages are prerendered to /index.html, /about.html, /book.html, /robotic-joint-replacement.html
# (served at /about etc.). Unknown URLs get /404.html with a 404 status automatically.

# Old WordPress URLs → new pages (301 = permanent, passes search ranking)
/about-2/*     /about                       301
/about-2       /about                       301
/robotics/*    /robotic-joint-replacement   301
/robotics      /robotic-joint-replacement   301
/contacts/*    /book                        301
/contacts      /book                        301
/form/*        /book                        301
/form          /book                        301

